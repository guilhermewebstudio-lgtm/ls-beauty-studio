<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/head') %>
</head>
<body class="pre-reveal">

  <div class="curtain" id="curtain">
    <div class="curtain-panel left"></div>
    <div class="curtain-panel right"></div>
    <div class="curtain-mark">
      <img src="/img/logo.png" alt="LS Beauty Studio" class="curtain-badge">
    </div>
  </div>

  <%- include('partials/nav') %>

  <main>
    <section class="hero hero-photo">
      <div class="hero-overlay"></div>
      <div class="hero-sparkles">
        <span class="sparkle s1"></span>
        <span class="sparkle s2"></span>
        <span class="sparkle s3"></span>
        <span class="sparkle s4"></span>
        <span class="sparkle s5"></span>
        <span class="sparkle s6"></span>
      </div>
      <div class="wrap hero-inner">
        <p class="eyebrow eyebrow-light reveal-item" data-d="1"><%= t('hero_eyebrow') %></p>
        <h1 class="hero-title-light reveal-item" data-d="2"><%= t('hero_title_pre') %><em><%= t('hero_title_em') %></em><%- t('hero_title_post').replace('\n', '<br>') %></h1>
        <p class="hero-sub hero-sub-light reveal-item" data-d="3"><%= t('hero_sub') %></p>
        <div class="hero-actions reveal-item" data-d="4">
          <a href="/marcar" class="btn btn-gold"><%= t('hero_btn_book') %></a>
          <a href="/servicos" class="btn btn-ghost-light"><%= t('hero_btn_services') %></a>
        </div>
      </div>
      <div class="hero-scroll hero-scroll-light reveal-item" data-d="5">
        <span></span>
        <p><%= t('hero_scroll') %></p>
      </div>
    </section>

    <section class="stats-band">
      <div class="wrap stats-band-inner">
        <div class="stat-block">
          <span class="stat-block-num" data-count="9">0</span>
          <span class="stat-block-label"><%= t('stats_services') %></span>
        </div>
        <div class="stat-block">
          <span class="stat-block-num" data-count="5">0</span>
          <span class="stat-block-label"><%= t('stats_categories') %></span>
        </div>
        <div class="stat-block">
          <span class="stat-block-num-text">Ter–Sáb</span>
          <span class="stat-block-label"><%= t('stats_hours_label') %></span>
        </div>
        <div class="stat-block">
          <span class="stat-block-num-text">100%</span>
          <span class="stat-block-label"><%= t('stats_products') %></span>
        </div>
      </div>
    </section>

    <section class="section intro-section">
      <div class="ambient-glow g-rose" style="top:-120px; left:-100px;"></div>
      <div class="ambient-glow g-gold" style="bottom:-140px; right:-80px;"></div>
      <div class="wrap intro-grid">
        <div class="intro-text scroll-reveal">
          <p class="eyebrow"><%= t('intro_eyebrow') %></p>
          <h2><%= t('intro_title') %></h2>
          <p><%= t('intro_body') %></p>
        </div>
        <div class="intro-quote scroll-reveal" data-delay="1">
          <p><%= t('intro_quote') %></p>
          <span><%= t('intro_quote_author') %></span>
        </div>
      </div>
    </section>

    <section class="section hours-section">
      <div class="ambient-glow g-rose" style="top:-100px; right:-120px;"></div>
      <div class="wrap hours-grid">
        <div class="hours-text scroll-reveal">
          <p class="eyebrow"><%= t('hours_eyebrow') %></p>
          <h2><%= t('hours_title') %></h2>
          <p><%= t('hours_body') %></p>
          <a href="/marcar" class="btn btn-primary"><%= t('pricing_btn') %></a>
        </div>
        <div class="hours-card scroll-reveal" data-delay="1">
          <div class="hours-row">
            <span><%= t('day_mon') %></span>
            <span class="hours-closed"><%= t('closed') %></span>
          </div>
          <div class="hours-row hours-open">
            <span><%= t('day_tue') %></span>
            <span><%= t('hours_time_range') %></span>
          </div>
          <div class="hours-row hours-open">
            <span><%= t('day_wed') %></span>
            <span><%= t('hours_time_range') %></span>
          </div>
          <div class="hours-row hours-open">
            <span><%= t('day_thu') %></span>
            <span><%= t('hours_time_range') %></span>
          </div>
          <div class="hours-row hours-open">
            <span><%= t('day_fri') %></span>
            <span><%= t('hours_time_range') %></span>
          </div>
          <div class="hours-row hours-open">
            <span><%= t('day_sat') %></span>
            <span><%= t('hours_time_range') %></span>
          </div>
          <div class="hours-row">
            <span><%= t('day_sun') %></span>
            <span class="hours-closed"><%= t('closed') %></span>
          </div>
        </div>
      </div>
    </section>

    <section class="section services-preview">
      <div class="wrap">
        <div class="section-head scroll-reveal">
          <p class="eyebrow"><%= t('services_eyebrow') %></p>
          <h2><%= t('services_title') %></h2>
        </div>
        <div class="service-cards">
          <% const categorias = [...new Set(servicos.map(s => s.categoria))].slice(0, 4); %>
          <% categorias.forEach(function(cat, i) { %>
            <% const s = servicos.find(x => x.categoria === cat); %>
            <div class="service-card scroll-reveal" data-delay="<%= i %>">
              <span class="service-index"><%= String(i + 1).padStart(2, '0') %></span>
              <h3><%= cat %></h3>
              <p><%= s.descricao %></p>
              <p class="service-from"><%= t('services_from') %> <%= Math.min(...servicos.filter(x => x.categoria === cat).map(x => x.preco)) %>€</p>
            </div>
          <% }); %>
        </div>
        <div class="center-cta">
          <a href="/servicos" class="btn btn-ghost"><%= t('services_see_all') %></a>
        </div>
      </div>
    </section>

    <section class="section why-section">
      <div class="ambient-glow g-gold" style="top:-80px; left:40%;"></div>
      <div class="wrap">
        <div class="section-head scroll-reveal">
          <p class="eyebrow"><%= t('why_eyebrow') %></p>
          <h2><%= t('why_title') %></h2>
        </div>
        <div class="why-grid">
          <div class="why-card scroll-reveal">
            <div class="why-icon">
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s-7.5-4.6-10-9.1C.5 8.2 2.4 4.5 6.1 4.1c2-.2 3.7.8 5.9 3 2.2-2.2 3.9-3.2 5.9-3 3.7.4 5.6 4.1 4.1 7.8C19.5 16.4 12 21 12 21Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
            </div>
            <h3><%= t('why_1_title') %></h3>
            <p><%= t('why_1_body') %></p>
          </div>
          <div class="why-card scroll-reveal" data-delay="1">
            <div class="why-icon">
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 2 14.6 8.6 21.8 9.2 16.3 13.9 18 21 12 17.3 6 21 7.7 13.9 2.2 9.2 9.4 8.6 12 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
            </div>
            <h3><%= t('why_2_title') %></h3>
            <p><%= t('why_2_body') %></p>
          </div>
          <div class="why-card scroll-reveal" data-delay="2">
            <div class="why-icon">
              <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3.2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <h3><%= t('why_3_title') %></h3>
            <p><%= t('why_3_body') %></p>
          </div>
          <div class="why-card scroll-reveal" data-delay="3">
            <div class="why-icon">
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 12c2-4 5-6 8-6s6 2 8 6c-2 4-5 6-8 6s-6-2-8-6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
            <h3><%= t('why_4_title') %></h3>
            <p><%= t('why_4_body') %></p>
          </div>
        </div>
      </div>
    </section>

    <section class="section gallery-section">
      <div class="wrap">
        <div class="section-head scroll-reveal">
          <p class="eyebrow"><%= t('gallery_eyebrow') %></p>
          <h2><%= t('gallery_title') %></h2>
        </div>
      </div>
      <div class="gallery-grid">
        <figure class="gallery-item span-2 scroll-reveal">
          <img src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1200&q=80" alt="Manicure em tons escuros com padrão de tartaruga">
        </figure>
        <figure class="gallery-item scroll-reveal" data-delay="1">
          <img src="https://images.unsplash.com/photo-1610992015762-45dca7fa3a85?auto=format&fit=crop&w=800&q=80" alt="Manicure em rosa claro sobre superfície branca">
        </figure>
        <figure class="gallery-item scroll-reveal" data-delay="2">
          <img src="https://images.unsplash.com/photo-1736434518489-0eb84070017f?auto=format&fit=crop&w=800&q=80" alt="Manicure segurando uma flor">
        </figure>
        <figure class="gallery-item scroll-reveal" data-delay="3">
          <img src="https://images.unsplash.com/photo-1607779097040-26e80aa78e66?auto=format&fit=crop&w=800&q=80" alt="Unhas com glitter prateado e malha branca">
        </figure>
        <figure class="gallery-item span-2 scroll-reveal">
          <img src="https://images.unsplash.com/photo-1619607146034-5a05296c8f9a?auto=format&fit=crop&w=1200&q=80" alt="Prateleiras douradas com vernizes coloridos">
        </figure>
        <figure class="gallery-item scroll-reveal" data-delay="1">
          <img src="https://images.unsplash.com/photo-1519014816548-bf5fe059798b?auto=format&fit=crop&w=800&q=80" alt="Foco seletivo em manicure rosa">
        </figure>
        <figure class="gallery-item scroll-reveal" data-delay="2">
          <img src="https://images.unsplash.com/photo-1571290274554-6a2eaa771e5f?auto=format&fit=crop&w=800&q=80" alt="Unhas cuidadas com manicure elegante">
        </figure>
      </div>
    </section>

    <section class="section pricing-section">
      <div class="pricing-glow"></div>
      <div class="wrap">
        <div class="section-head scroll-reveal">
          <p class="eyebrow"><%= t('pricing_eyebrow') %></p>
          <h2><%= t('pricing_title') %></h2>
        </div>
        <div class="pricing-columns">
          <% const porCategoriaHome = {}; servicos.forEach(s => { (porCategoriaHome[s.categoria] = porCategoriaHome[s.categoria] || []).push(s); }); %>
          <% Object.keys(porCategoriaHome).forEach(function(cat, i) { %>
            <div class="pricing-col scroll-reveal" data-delay="<%= i %>">
              <h3><%= cat %></h3>
              <ul class="pricing-list">
                <% porCategoriaHome[cat].forEach(function(s) { %>
                  <li>
                    <span class="pricing-name"><%= s.nome %></span>
                    <span class="pricing-dots"></span>
                    <span class="pricing-value"><%= s.preco %>€</span>
                  </li>
                <% }); %>
              </ul>
            </div>
          <% }); %>
        </div>
        <div class="center-cta scroll-reveal">
          <a href="/marcar" class="btn btn-primary"><%= t('pricing_btn') %></a>
        </div>
      </div>
    </section>

    <section class="section map-section">
      <div class="wrap">
        <div class="section-head scroll-reveal">
          <p class="eyebrow"><%= t('map_eyebrow') %></p>
          <h2><%= t('map_title') %></h2>
          <p class="map-address"><%= t('contact_address') %></p>
        </div>
      </div>
      <div class="map-embed scroll-reveal">
        <iframe
          src="https://www.google.com/maps?q=Rua+Cláudio+Nunes+8,+Benfica,+Lisboa&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Localização do LS Beauty Studio em Benfica, Lisboa">
        </iframe>
      </div>
      <div class="center-cta" style="margin-top:28px;">
        <a href="https://www.google.com/maps?q=Rua+Cláudio+Nunes+8,+Benfica,+Lisboa" target="_blank" rel="noopener" class="btn btn-ghost"><%= t('footer_view_map') %></a>
      </div>
    </section>

    <section class="section cta-band">
      <div class="wrap cta-band-inner scroll-reveal">
        <h2><%= t('cta_title') %></h2>
        <a href="/marcar" class="btn btn-primary-inverse"><%= t('cta_btn') %></a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>

  <script src="/js/reveal.js"></script>
  <script src="/js/animate.js"></script>
  <script src="/js/chatbot.js"></script>
</body>
</html>
