<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body class="pre-reveal">

  <div class="curtain" id="curtain">
    <div class="curtain-panel left"></div>
    <div class="curtain-panel right"></div>
    <div class="curtain-mark">
      <span>LS</span>
      <em>Beauty Studio</em>
    </div>
  </div>

  <%- include('partials/nav') %>

  <main>
    <section class="hero">
      <div class="hero-glow"></div>
      <div class="wrap hero-inner">
        <p class="eyebrow reveal-item" data-d="1">Benfica · Lisboa</p>
        <h1 class="reveal-item" data-d="2">Beleza que <em>se sente</em>,<br>antes de se ver.</h1>
        <p class="hero-sub reveal-item" data-d="3">Unhas, cabelo, sobrancelhas, pestanas e estética facial — num espaço pensado para desacelerares.</p>
        <div class="hero-actions reveal-item" data-d="4">
          <a href="/marcar" class="btn btn-primary">Marcar sessão</a>
          <a href="/servicos" class="btn btn-ghost">Ver serviços</a>
        </div>
      </div>
      <div class="hero-scroll reveal-item" data-d="5">
        <span></span>
        <p>Descobre mais</p>
      </div>
    </section>

    <section class="section intro-section">
      <div class="wrap intro-grid">
        <div class="intro-text">
          <p class="eyebrow">O estúdio</p>
          <h2>Um cuidado atento, em cada detalhe.</h2>
          <p>No LS Beauty Studio, cada marcação é um momento só teu. Trabalhamos com produtos de qualidade e técnicas atuais, num ambiente calmo em pleno coração de Benfica.</p>
        </div>
        <div class="intro-stats">
          <div class="stat">
            <span class="stat-num">9</span>
            <span class="stat-label">Serviços especializados</span>
          </div>
          <div class="stat">
            <span class="stat-num">Ter–Sáb</span>
            <span class="stat-label">10h00 – 19h30</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section services-preview">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Serviços</p>
          <h2>O que fazemos por ti</h2>
        </div>
        <div class="service-cards">
          <% const categorias = [...new Set(servicos.map(s => s.categoria))].slice(0, 4); %>
          <% categorias.forEach(function(cat, i) { %>
            <% const s = servicos.find(x => x.categoria === cat); %>
            <div class="service-card">
              <span class="service-index"><%= String(i + 1).padStart(2, '0') %></span>
              <h3><%= cat %></h3>
              <p><%= s.descricao %></p>
              <p class="service-from">desde <%= Math.min(...servicos.filter(x => x.categoria === cat).map(x => x.preco)) %>€</p>
            </div>
          <% }); %>
        </div>
        <div class="center-cta">
          <a href="/servicos" class="btn btn-ghost">Ver todos os serviços</a>
        </div>
      </div>
    </section>

    <section class="section gallery-section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Galeria</p>
          <h2>Trabalhos que falam por si</h2>
        </div>
      </div>
      <div class="gallery-grid">
        <figure class="gallery-item span-2">
          <img src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1200&q=80" alt="Manicure em tons escuros com padrão de tartaruga">
        </figure>
        <figure class="gallery-item">
          <img src="https://images.unsplash.com/photo-1610992015762-45dca7fa3a85?auto=format&fit=crop&w=800&q=80" alt="Manicure em rosa claro sobre superfície branca">
        </figure>
        <figure class="gallery-item">
          <img src="https://images.unsplash.com/photo-1736434518489-0eb84070017f?auto=format&fit=crop&w=800&q=80" alt="Manicure segurando uma flor">
        </figure>
        <figure class="gallery-item">
          <img src="https://images.unsplash.com/photo-1607779097040-26e80aa78e66?auto=format&fit=crop&w=800&q=80" alt="Unhas com glitter prateado e malha branca">
        </figure>
        <figure class="gallery-item span-2">
          <img src="https://images.unsplash.com/photo-1619607146034-5a05296c8f9a?auto=format&fit=crop&w=1200&q=80" alt="Prateleiras douradas com vernizes coloridos">
        </figure>
        <figure class="gallery-item">
          <img src="https://images.unsplash.com/photo-1519014816548-bf5fe059798b?auto=format&fit=crop&w=800&q=80" alt="Foco seletivo em manicure rosa">
        </figure>
        <figure class="gallery-item">
          <img src="https://images.unsplash.com/photo-1571290274554-6a2eaa771e5f?auto=format&fit=crop&w=800&q=80" alt="Unhas cuidadas com manicure elegante">
        </figure>
      </div>
    </section>

    <section class="section pricing-section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Preços</p>
          <h2>Investe em ti, sem surpresas</h2>
        </div>
        <div class="pricing-columns">
          <% const porCategoriaHome = {}; servicos.forEach(s => { (porCategoriaHome[s.categoria] = porCategoriaHome[s.categoria] || []).push(s); }); %>
          <% Object.keys(porCategoriaHome).forEach(function(cat) { %>
            <div class="pricing-col">
              <h3><%= cat %></h3>
              <ul class="pricing-list">
                <% porCategoriaHome[cat].forEach(function(s) { %>
                  <li>
                    <span class="pricing-name"><%= s.nome %></span>
                    <span class="pricing-dots"></span>
                    <span class="pricing-value"><%= s.preco %>€</span>
                  </li>
                <% }); %>
              </ul>
            </div>
          <% }); %>
        </div>
        <div class="center-cta">
          <a href="/marcar" class="btn btn-primary">Marcar sessão</a>
        </div>
      </div>
    </section>

    <section class="section cta-band">
      <div class="wrap cta-band-inner">
        <h2>Pronta para o teu momento de cuidado?</h2>
        <a href="/marcar" class="btn btn-primary-inverse">Marcar agora</a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>

  <script src="/js/reveal.js"></script>
  <script src="/js/chatbot.js"></script>
</body>
</html>
