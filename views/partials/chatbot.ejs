<div class="chat-widget" id="chatWidget">
  <button class="chat-toggle" id="chatToggle" aria-label="Abrir assistente virtual">
    <svg class="icon-chat" viewBox="0 0 24 24" fill="none"><path d="M4 5.5C4 4.67 4.67 4 5.5 4h13c.83 0 1.5.67 1.5 1.5v10c0 .83-.67 1.5-1.5 1.5H9l-4 3.5v-3.5H5.5C4.67 17 4 16.33 4 15.5v-10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
    <svg class="icon-close" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  </button>

  <div class="chat-panel" id="chatPanel">
    <div class="chat-panel-header">
      <div>
        <p class="chat-title"><%= t('chat_title') %></p>
        <p class="chat-subtitle"><%= t('chat_subtitle') %></p>
      </div>
    </div>
    <div class="chat-messages" id="chatMessages">
      <div class="msg msg-bot"><%= t('chat_intro') %></div>
    </div>
    <div class="chat-quick" id="chatQuick">
      <button data-msg="<%= t('chat_quick_hours_msg') %>"><%= t('chat_quick_hours') %></button>
      <button data-msg="<%= t('chat_quick_prices_msg') %>"><%= t('chat_quick_prices') %></button>
      <button data-msg="<%= t('chat_quick_book_msg') %>"><%= t('chat_quick_book') %></button>
    </div>
    <form class="chat-input-row" id="chatForm">
      <input type="text" id="chatInput" placeholder="<%= t('chat_placeholder') %>" autocomplete="off">
      <button type="submit" aria-label="Enviar">
        <svg viewBox="0 0 24 24" fill="none"><path d="M4 12h16M14 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </form>
  </div>
</div>
