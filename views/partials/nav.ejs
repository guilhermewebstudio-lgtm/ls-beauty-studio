<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <img src="/img/logo.png" alt="LS Beauty Studio" class="brand-badge">
      <span class="brand-name">Beauty Studio</span>
    </a>
    <nav class="main-nav">
      <a href="/"><%= t('nav_home') %></a>
      <a href="/servicos"><%= t('nav_services') %></a>
      <a href="/marcar" class="nav-cta"><%= t('nav_book') %></a>
      <a href="/contactos"><%= t('nav_contact') %></a>
      <a href="/sugestoes"><%= t('nav_suggestions') %></a>
      <% if (user) { %>
        <% if (user.isAdmin) { %>
          <a href="/admin" class="nav-admin">Gestão</a>
        <% } %>
        <a href="/conta" class="nav-account"><%= user.nome.split(' ')[0] %></a>
      <% } else { %>
        <a href="/login"><%= t('nav_login') %></a>
      <% } %>
      <span class="lang-switch">
        <a href="/lang/pt" class="lang-btn <%= lang === 'pt' ? 'active' : '' %>">PT</a>
        <span class="lang-sep">/</span>
        <a href="/lang/en" class="lang-btn <%= lang === 'en' ? 'active' : '' %>">EN</a>
      </span>
    </nav>
    <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
