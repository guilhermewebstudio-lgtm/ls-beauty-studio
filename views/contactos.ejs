<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>

  <main>
    <section class="page-header">
      <div class="wrap scroll-reveal">
        <p class="eyebrow"><%= t('page_contact_eyebrow') %></p>
        <h1><%= t('page_contact_title') %></h1>
      </div>
    </section>

    <section class="section">
      <div class="wrap contact-grid">
        <div class="contact-info">
          <div>
            <h3><%= t('contact_address_title') %></h3>
            <p><%= t('contact_address') %></p>
          </div>
          <div>
            <h3><%= t('contact_hours_title') %></h3>
            <p><%= t('footer_hours_days') %>, <%= t('footer_hours_time') %></p>
          </div>
          <div>
            <h3><%= t('contact_social_title') %></h3>
            <p><a href="<%= social.instagram %>" target="_blank" rel="noopener">Instagram</a></p>
          </div>
        </div>

        <div class="contact-form-wrap">
          <% if (sucesso) { %>
            <div class="alert alert-success"><p><%= t('contact_success') %></p></div>
          <% } %>
          <form class="booking-form" method="POST" action="/contactos">
            <label>
              <%= t('form_name') %>
              <input type="text" name="nome" required>
            </label>
            <label>
              <%= t('form_email') %>
              <input type="email" name="email" required>
            </label>
            <label>
              <%= t('form_message') %>
              <textarea name="mensagem" rows="5" required></textarea>
            </label>
            <button type="submit" class="btn btn-primary btn-block"><%= t('form_send') %></button>
          </form>
        </div>
      </div>
    </section>

    <section class="section map-section">
      <div class="wrap">
        <div class="section-head scroll-reveal">
          <p class="eyebrow"><%= t('map_eyebrow') %></p>
          <h2><%= t('map_title') %></h2>
        </div>
      </div>
      <div class="map-embed">
        <iframe
          src="https://www.google.com/maps?q=Rua+Cláudio+Nunes+8,+Benfica,+Lisboa&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Localização do LS Beauty Studio em Benfica, Lisboa">
        </iframe>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>
  <script src="/js/reveal.js"></script>
  <script src="/js/animate.js"></script>
  <script src="/js/chatbot.js"></script>
</body>
</html>
