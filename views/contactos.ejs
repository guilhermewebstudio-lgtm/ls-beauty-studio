<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>

  <main>
    <section class="page-header">
      <div class="wrap">
        <p class="eyebrow">Contactos</p>
        <h1>Fala connosco</h1>
      </div>
    </section>

    <section class="section">
      <div class="wrap contact-grid">
        <div class="contact-info">
          <div>
            <h3>Morada</h3>
            <p>Rua de Benfica, Lisboa</p>
          </div>
          <div>
            <h3>Horário</h3>
            <p>Terça – Sábado, 10h00 – 19h30</p>
          </div>
          <div>
            <h3>Redes sociais</h3>
            <p><a href="#">Instagram</a> · <a href="#">Facebook</a></p>
          </div>
        </div>

        <div class="contact-form-wrap">
          <% if (sucesso) { %>
            <div class="alert alert-success"><p>Mensagem enviada! Respondemos assim que possível.</p></div>
          <% } %>
          <form class="booking-form" method="POST" action="/contactos">
            <label>
              Nome
              <input type="text" name="nome" required>
            </label>
            <label>
              Email
              <input type="email" name="email" required>
            </label>
            <label>
              Mensagem
              <textarea name="mensagem" rows="5" required></textarea>
            </label>
            <button type="submit" class="btn btn-primary btn-block">Enviar mensagem</button>
          </form>
        </div>
      </div>
    </section>

    <section class="section map-section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Onde estamos</p>
          <h2>Vem visitar-nos</h2>
        </div>
      </div>
      <div class="map-embed">
        <iframe
          src="https://www.google.com/maps?q=Rua+de+Benfica,+Lisboa&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Localização do LS Beauty Studio em Benfica, Lisboa">
        </iframe>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>
  <script src="/js/reveal.js"></script>
  <script src="/js/animate.js"></script>
  <script src="/js/chatbot.js"></script>
</body>
</html>
