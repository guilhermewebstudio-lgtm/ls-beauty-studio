<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>

  <main>
    <section class="page-header">
      <div class="wrap scroll-reveal">
        <p class="eyebrow"><%= t('page_book_eyebrow') %></p>
        <h1><%= t('page_book_title') %></h1>
        <p class="page-header-sub"><%= t('page_book_sub') %></p>
      </div>
    </section>

    <section class="section">
      <div class="wrap form-wrap">
        <% if (sucesso) { %>
          <div class="alert alert-success">
            <h3><%= t('booking_success_title') %></h3>
            <p><%= t('booking_success_body') %></p>
          </div>
        <% } %>
        <% if (erro) { %>
          <div class="alert alert-error"><p><%= erro %></p></div>
        <% } %>

        <form class="booking-form" method="POST" action="/marcar">
          <div class="form-row">
            <label>
              <%= t('form_name') %>
              <input type="text" name="nome_cliente" required>
            </label>
            <label>
              <%= t('form_phone') %>
              <input type="tel" name="telefone" required>
            </label>
          </div>
          <label>
            <%= t('form_email') %>
            <input type="email" name="email" required>
          </label>
          <label>
            <%= t('form_service') %>
            <select name="servico_id" required>
              <option value="" disabled selected><%= t('form_service_placeholder') %></option>
              <% servicos.forEach(function(s) { %>
                <option value="<%= s.id %>"><%= s.nome %> — <%= s.preco %>€ (<%= s.duracao_min %> min)</option>
              <% }); %>
            </select>
          </label>
          <div class="form-row">
            <label>
              <%= t('form_date') %>
              <input type="date" name="data" required>
            </label>
            <label>
              <%= t('form_time') %>
              <input type="time" name="hora" required>
            </label>
          </div>
          <label>
            <%= t('form_notes') %>
            <textarea name="notas" rows="3" placeholder="<%= t('form_notes_placeholder') %>"></textarea>
          </label>
          <button type="submit" class="btn btn-primary btn-block"><%= t('form_confirm') %></button>
        </form>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>
  <script src="/js/reveal.js"></script>
  <script src="/js/animate.js"></script>
  <script src="/js/chatbot.js"></script>
</body>
</html>
